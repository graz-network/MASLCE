@article{le_moigne_focus_2019,
	title = {To focus on processes, Les Sciences de l’artificiel, cinquante ans après: Essentielle contribution épistémologique et civique à la formation des Sciences de la Cognition et des Sciences d’Ingénierie},
	volume = {24},
	issn = {2031-9703},
	doi = {10.3917/proj.024.0027},
	shorttitle = {To focus on processes, Les Sciences de l’artificiel, cinquante ans après},
	abstract = {Lorsque parait en 1969 la première édition de The Science of the Artificial , l’ouvrage embarrassa d’abord les libraires et documentalistes : dans quelle rubrique disciplinaire le classer ? Non seulement il témoignait des compétences réfléchies d’H. A. Simon alors âgé de 53 ans dans la plupart des aires de connaissances reconnues par les académies des sciences mais il argumentait aussi la légitimité gnoséologique et épistémologique de ces ‘nouvelles sciences’ que sont les sciences de l’artificiel, les sciences d’ingénierie, les sciences de conception, se formant sur des ‘projets’ plutôt que sur des ‘objets dits naturels’.L’aventure de ce livre dans nos cultures mérite alors d’être contée puisqu’elle se poursuit cinquante après. Genèse de 1945 à 1968 : éclairée par les élections aux Académies des Arts \& Sciences en 1959 et 67. Deuxième phase, celle d’une croissance étonnante de 1969 à 1981 : 3 chapitres de plus pour la deuxième édition, prix Turing de l’{ACM} (Informatique) 1975, prix Nobel (Economie) 1978 ; Troisième phase 1981-1996-2001, marquée par la parution du manifeste épistémologique Reason in Human Affairs (1983) qui va contribuer au renouvellement paradigmatique de l’épistémologie complexe par les ‘nouvelles sciences’ que sont les sciences de l’artificiel, les sciences d’ingénierie, les sciences des systèmes complexes, les sciences de conception.},
	pages = {27--41},
	number = {3},
	journaltitle = {Projectics},
	publisher = {De Boeck Supérieur},
	author = {Le Moigne, Jean-Louis},
	date = {2019},
	note = {{ISBN}: 9782807393011},
}

